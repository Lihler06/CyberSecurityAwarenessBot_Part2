<Window x:Class="CyberSecurityAwarenessBot_Part2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CyberSecurityAwarenessBot_Part2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid Background="#1E1E1E">

            <!-- Title -->
            <TextBlock Text="Cybersecurity Awareness Bot"
               Foreground="Cyan"
               FontSize="28"
               FontWeight="Bold"
               HorizontalAlignment="Center"
               Margin="0,10,0,0"/>

            <!-- ASCII Style Header -->
            <TextBlock Text="
   ██████╗██╗   ██╗██████╗ ███████╗██████╗ 
  ██╔════╝╚██╗ ██╔╝██╔══██╗██╔════╝██╔══██╗
  ██║      ╚████╔╝ ██████╔╝█████╗  ██████╔╝
  ██║       ╚██╔╝  ██╔══██╗██╔══╝  ██╔══██╗
  ╚██████╗   ██║   ██████╔╝███████╗██║  ██║
   ╚═════╝   ╚═╝   ╚═════╝ ╚══════╝╚═╝  ╚═╝"
               Foreground="LightGreen"
               FontFamily="Consolas"
               FontSize="12"
               Margin="20,60,19,0"
               VerticalAlignment="Top" Height="55"/>

            <!-- Chat Display -->
            <TextBox x:Name="ChatDisplay"
             Margin="20,180,20,80"
             Background="#2D2D30"
             Foreground="White"
             FontSize="14"
             TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto"
             IsReadOnly="True"/>

            <!-- User Input -->
            <TextBox x:Name="UserInput"
             Height="35"
             Margin="20,0,120,20"
             VerticalAlignment="Bottom"
             FontSize="14"
             KeyDown="UserInput_KeyDown"/>

            <!-- Send Button -->
            <Button x:Name="SendButton"
            Content="Send"
            Width="80"
            Height="35"
            Margin="0,0,20,20"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="Cyan"
            Foreground="Black"
            FontWeight="Bold"
            Click="SendButton_Click"/>
        </Grid>

    </Grid>
</Window>
